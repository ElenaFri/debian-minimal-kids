#!/bin/sh

# =============================================================================
# Installe Scratch (absent des depots Debian) via Flatpak / Flathub.
# Ce hook s'execute DANS le chroot pendant le build (apres l'installation du
# paquet « flatpak » declare dans apps.list.chroot).
#
# ATTENTION : Scratch tire un runtime GNOME volumineux (plusieurs centaines de
# Mo). Cela alourdit sensiblement la taille de l'ISO.
# =============================================================================

set -e

flatpak remote-add --if-not-exists flathub \
    https://flathub.org/repo/flathub.flatpakrepo

flatpak install --system --assumeyes --noninteractive flathub edu.mit.Scratch
