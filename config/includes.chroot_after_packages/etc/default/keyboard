# Disposition clavier par défaut : français (AZERTY, variante latin9).
#
# Sur le LIVE, live-config réécrit ce fichier au démarrage à partir du paramètre
# de boot live-config.keyboard-layouts=fr : le live est toujours en AZERTY.
#
# Sur le système INSTALLÉ, Calamares copie le squashfs et son module clavier
# hérite de la disposition du live (AZERTY) ; ce fichier fixe ce défaut français,
# de la même façon que le hook 1030 garantit une locale française.
XKBMODEL="pc105"
XKBLAYOUT="fr"
XKBVARIANT="latin9"
XKBOPTIONS=""

BACKSPACE="guess"
