# Disposition clavier de la CONSOLE : français (AZERTY, variante latin9).
#
# ATTENTION : ce fichier ne pilote que la console (console-setup). Le serveur X
# (session XFCE + installateur Calamares) lit, lui, /etc/X11/xorg.conf.d/00-keyboard.conf
# — voir ce fichier pour la disposition graphique. Les deux sont gardés cohérents
# (fr/latin9/pc105).
#
# Sur le système INSTALLÉ, Calamares copie le squashfs et hérite de ces deux
# fichiers ; son module clavier détecte alors « fr » et l'écrit sur la cible.
XKBMODEL="pc105"
XKBLAYOUT="fr"
XKBVARIANT="latin9"
XKBOPTIONS=""

BACKSPACE="guess"
