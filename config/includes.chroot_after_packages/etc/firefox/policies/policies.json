{
  "policies": {
    "DNSOverHTTPS": {
      "Enabled": false,
      "Locked": true
    },
    "BlockAboutConfig": true,
    "DisablePrivateBrowsing": true,
    "DisableProfileImport": true,
    "InstallAddonsPermission": {
      "Default": false
    },

    "WebsiteFilter": {
      "Block": [
        "*://*.omegle.com/*",
        "*://*.chatroulette.com/*",
        "*://*.ome.tv/*",
        "*://*.emeraldchat.com/*",
        "*://*.monkey.app/*",
        "*://*.discord.com/*",
        "*://*.discordapp.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.snapchat.com/*",
        "*://*.facebook.com/*",
        "*://*.messenger.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.twitch.tv/*",
        "*://*.roblox.com/*",
        "*://*.kik.com/*",
        "*://web.telegram.org/*",
        "*://*.telegram.org/*",
        "*://web.whatsapp.com/*",
        "*://*.whatsapp.com/*"
      ]
    },

    "NoDefaultBookmarks": true,
    "Homepage": {
      "URL": "https://www.lumni.fr"
    },
    "Preferences": {
      "browser.toolbars.bookmarks.visibility": {
        "Value": "always",
        "Status": "locked"
      },
      "browser.ml.chat.provider": {
        "Value": "https://chat.mistral.ai/chat",
        "Status": "locked"
      }
    },

    "SearchEngines": {
      "Add": [
        {
          "Name": "Qwant Junior",
          "URLTemplate": "https://www.qwantjunior.com/?q={searchTerms}",
          "SuggestURLTemplate": "https://api.qwant.com/egp/suggest/?client=opensearch&q={searchTerms}",
          "Method": "GET"
        }
      ],
      "Default": "Qwant Junior",
      "Remove": [
        "Google",
        "Bing",
        "DuckDuckGo",
        "eBay",
        "Amazon.fr",
        "Amazon.com",
        "Qwant",
        "Wikipédia (fr)",
        "Wikipedia (fr)",
        "Wikipedia (en)"
      ],
      "PreventInstalls": true
    },

    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisableFirefoxAccounts": true,
    "DisableAppUpdate": true,
    "DisableProfileRefresh": true,
    "DisableFormHistory": true,
    "OfferToSaveLogins": false,
    "DontCheckDefaultBrowser": true,
    "OverrideFirstRunPage": "",
    "CaptivePortal": false
  }
}
